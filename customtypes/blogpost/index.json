{
  "format": "page",
  "id": "blogpost",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "label": "title",
          "placeholder": ""
        },
        "type": "Text"
      },
      "paragraph": {
        "config": {
          "allowTargetBlank": true,
          "label": "paragraph",
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
          "placeholder": ""
        },
        "type": "StructuredText"
      },
      "content": {
        "config": {
          "allowTargetBlank": true,
          "label": "content",
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
          "placeholder": ""
        },
        "type": "StructuredText"
      },
      "image": {
        "config": {
          "constraint": {},
          "label": "image",
          "thumbnails": []
        },
        "type": "Image"
      },
      "slices": {
        "config": {
          "choices": {
            "blog_post": {
              "type": "SharedSlice"
            }
          }
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      },
      "post_kind": {
        "config": {
          "default_value": "news",
          "label": "Post kind",
          "options": [
            "news",
            "press"
          ]
        },
        "type": "Select"
      },
      "source_name": {
        "config": {
          "label": "Source name (outlet)"
        },
        "type": "Text"
      },
      "source_url": {
        "config": {
          "label": "Source link (original article/audio)",
          "select": "web"
        },
        "type": "Link"
      },
      "source_label": {
        "config": {
          "label": "Source button text"
        },
        "type": "Text"
      },
      "publication_date": {
        "config": {
          "label": "Publication date (real date of the piece)"
        },
        "type": "Date"
      },
      "video_url": {
        "config": {
          "label": "Video link (YouTube)",
          "select": "web"
        },
        "type": "Link"
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  },
  "label": "blogpost",
  "repeatable": true,
  "status": true
}